<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GLMS</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --primary: #1a3c5e;
            --accent: #2e86c1;
            --light-bg: #f0f4f8;
            --sidebar-width: 230px;
        }

        body {
            background-color: var(--light-bg);
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
            margin: 0;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--primary);
            color: white;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            z-index: 100;
            box-shadow: 2px 0 8px rgba(0,0,0,0.15);
        }

        .sidebar-brand {
            padding: 24px 20px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

            .sidebar-brand h5 {
                color: white;
                font-weight: 700;
                font-size: 1rem;
                margin: 0;
                letter-spacing: 0.5px;
            }

            .sidebar-brand small {
                color: rgba(255,255,255,0.5);
                font-size: 0.72rem;
            }

        .sidebar-logo {
            width: 38px;
            height: 38px;
            background: var(--accent);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            font-size: 1.2rem;
        }

        .sidebar nav {
            padding: 16px 0;
            flex: 1;
        }

        .sidebar .nav-label {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            padding: 8px 20px 4px;
        }

        .sidebar .nav-link {
            color: rgba(255,255,255,0.75);
            padding: 10px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.88rem;
            text-decoration: none;
            transition: background 0.2s, color 0.2s;
        }

            .sidebar .nav-link:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

            .sidebar .nav-link i {
                width: 18px;
                text-align: center;
                font-size: 0.9rem;
            }

        /* ── Main content ── */
        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Standard layout spacing adjustment when sidebar is active */
        body.has-sidebar .main-wrapper {
            margin-left: var(--sidebar-width);
        }

        .topbar {
            background: white;
            padding: 14px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #dde3ea;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .topbar-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--primary);
        }

        .topbar-badge {
            background: var(--light-bg);
            color: var(--primary);
            font-size: 0.78rem;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 500;
        }

        .page-content {
            padding: 28px;
            flex: 1;
        }

        footer {
            background: white;
            border-top: 1px solid #eef0f3;
            padding: 12px 28px;
            font-size: 0.78rem;
            color: #a0aec0;
        }
    </style>
</head>
@{
        // C# Check: Is the user logged into a valid session?
        bool isUserLoggedIn = Context.Session.GetString("JwtToken") != null;
}
<body class="@(isUserLoggedIn ? "has-sidebar" : "")">

    @if (isUserLoggedIn)
    {
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="sidebar-logo"><i class="fas fa-truck-fast"></i></div>
                <h5>TechMove GLMS</h5>
                <small>Logistics Management</small>
            </div>
            <nav>
                <div class="nav-label">Main Menu</div>
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-house"></i> Dashboard
                </a>
                <div class="nav-label mt-2">Management</div>
                <a class="nav-link" asp-controller="Clients" asp-action="Index">
                    <i class="fas fa-users"></i> Clients
                </a>
                <a class="nav-link" asp-controller="Contracts" asp-action="Index">
                    <i class="fas fa-file-contract"></i> Contracts
                </a>
                <a class="nav-link" asp-controller="ServiceRequests" asp-action="Index">
                    <i class="fas fa-clipboard-list"></i> Service Requests
                </a>
            </nav>
        </aside>
    }

    <div class="main-wrapper">
        @if (isUserLoggedIn)
        {
            <div class="topbar">
                <span class="topbar-title">@ViewData["Title"]</span>
                <div class="d-flex align-items-center gap-3">
                    <span class="topbar-badge">
                        <i class="fas fa-circle-check text-success me-1"></i>System Online
                    </span>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-right-from-bracket me-1"></i>Logout
                    </a>
                </div>
            </div>
        }

        <div class="page-content">
            @RenderBody()
        </div>

        @if (isUserLoggedIn)
        {
            <footer>
                &copy; @DateTime.Now.Year TechMove Logistics &mdash; Global Logistics Management System
            </footer>
        }
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>