@model IEnumerable<GLMS.Models.ServiceRequest>
@{
    ViewData["Title"] = "Service Requests";
}

<h2>Service Requests</h2>
<p><a asp-action="Create" class="btn btn-primary">New Service Request</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Contract</th>
            <th>Description</th>
            <th>Cost (USD)</th>
            <th>Cost (ZAR)</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Contract?.ServiceLevel</td>
                <td>@item.Description</td>
                <td>$@item.CostUSD.ToString("F2")</td>
                <td>R @item.CostZAR.ToString("F2")</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
