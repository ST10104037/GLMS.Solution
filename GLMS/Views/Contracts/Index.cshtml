@model IEnumerable<GLMS.Models.Contract>
@{
    ViewData["Title"] = "Contracts";
}

<h2>Contracts</h2>
<p><a asp-action="Create" class="btn btn-primary">Add New Contract</a></p>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Start Date From</label>
        <input type="date" name="startDate" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">End Date To</label>
        <input type="date" name="endDate" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
            <option value="">-- All --</option>
            @foreach (var s in Enum.GetValues(typeof(GLMS.Models.ContractStatus)))
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary me-2">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Client</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th>Service Level</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Client?.Name</td>
                <td>@item.StartDate.ToShortDateString()</td>
                <td>@item.EndDate.ToShortDateString()</td>
                <td>
                    <span class="badge
                            @(item.Status == GLMS.Models.ContractStatus.Active ? "bg-success" :
                                                    item.Status == GLMS.Models.ContractStatus.Expired ? "bg-danger" :
                                                    item.Status == GLMS.Models.ContractStatus.OnHold ? "bg-warning" : "bg-secondary")">
                    @item.Status
                </span>
            </td>
            <td>@item.ServiceLevel</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
                }
    </tbody>
</table>
