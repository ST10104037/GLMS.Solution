@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e8f4fd;">
                <i class="fas fa-users" style="color:#2e86c1;"></i>
            </div>
            <div>
                <div class="stat-label">Total Clients</div>
                <div class="stat-value">@ViewBag.ClientCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e8f8f0;">
                <i class="fas fa-file-contract" style="color:#27ae60;"></i>
            </div>
            <div>
                <div class="stat-label">Active Contracts</div>
                <div class="stat-value">@ViewBag.ActiveContracts</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fef9e7;">
                <i class="fas fa-clipboard-list" style="color:#f39c12;"></i>
            </div>
            <div>
                <div class="stat-label">Service Requests</div>
                <div class="stat-value">@ViewBag.RequestCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fas fa-bolt me-2"></i>Quick Actions
    </div>
    <div class="card-body d-flex gap-3 flex-wrap p-4">
        <a asp-controller="Clients" asp-action="Create" class="btn btn-primary">
            <i class="fas fa-user-plus me-1"></i> Add Client
        </a>
        <a asp-controller="Contracts" asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus me-1"></i> New Contract
        </a>
        <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-warning text-white">
            <i class="fas fa-clipboard-plus me-1"></i> New Service Request
        </a>
    </div>
</div>