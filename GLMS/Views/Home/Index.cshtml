@{
    ViewData["Title"] = "Dashboard";
}

<!-- Welcome Banner -->
<div style="background: linear-gradient(135deg, #1a3c5e 0%, #2e86c1 100%); border-radius: 16px; padding: 32px 36px; margin-bottom: 28px; position: relative; overflow: hidden;">
    <div style="position:absolute; top:-40px; right:-40px; width:200px; height:200px; background:rgba(255,255,255,0.05); border-radius:50%;"></div>
    <div style="position:absolute; bottom:-60px; right:120px; width:150px; height:150px; background:rgba(255,255,255,0.04); border-radius:50%;"></div>
    <div style="position: relative; z-index:1;">
        <p style="color:rgba(255,255,255,0.7); font-size:0.85rem; margin-bottom:4px; text-transform:uppercase; letter-spacing:1px;">Welcome back, Administrator</p>
        <h2 style="color:white; font-weight:800; font-size:1.8rem; margin-bottom:8px;">TechMove Logistics Hub</h2>
        <p style="color:rgba(255,255,255,0.65); font-size:0.9rem; margin:0;">Monitor your global freight operations, contracts, and service requests from one place.</p>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div style="background:white; border-radius:14px; padding:24px; box-shadow:0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #2e86c1; display:flex; align-items:center; gap:18px;">
            <div style="width:54px; height:54px; background:linear-gradient(135deg,#ebf5fb,#d6eaf8); border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                <i class="fas fa-users" style="color:#2e86c1;"></i>
            </div>
            <div>
                <p style="font-size:0.75rem; color:#a0aec0; text-transform:uppercase; letter-spacing:0.5px; margin:0;">Total Clients</p>
                <h3 style="font-size:2rem; font-weight:800; color:#1a3c5e; margin:0;">@ViewBag.ClientCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div style="background:white; border-radius:14px; padding:24px; box-shadow:0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #27ae60; display:flex; align-items:center; gap:18px;">
            <div style="width:54px; height:54px; background:linear-gradient(135deg,#eafaf1,#d5f5e3); border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                <i class="fas fa-file-contract" style="color:#27ae60;"></i>
            </div>
            <div>
                <p style="font-size:0.75rem; color:#a0aec0; text-transform:uppercase; letter-spacing:0.5px; margin:0;">Active Contracts</p>
                <h3 style="font-size:2rem; font-weight:800; color:#1a3c5e; margin:0;">@ViewBag.ActiveContracts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div style="background:white; border-radius:14px; padding:24px; box-shadow:0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #f39c12; display:flex; align-items:center; gap:18px;">
            <div style="width:54px; height:54px; background:linear-gradient(135deg,#fef9e7,#fdebd0); border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                <i class="fas fa-clipboard-list" style="color:#f39c12;"></i>
            </div>
            <div>
                <p style="font-size:0.75rem; color:#a0aec0; text-transform:uppercase; letter-spacing:0.5px; margin:0;">Service Requests</p>
                <h3 style="font-size:2rem; font-weight:800; color:#1a3c5e; margin:0;">@ViewBag.RequestCount</h3>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions + System Status -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div style="background:white; border-radius:14px; padding:24px; box-shadow:0 2px 12px rgba(0,0,0,0.06); height:100%;">
            <h5 style="color:#1a3c5e; font-weight:700; margin-bottom:6px;"><i class="fas fa-bolt me-2" style="color:#f39c12;"></i>Quick Actions</h5>
            <p style="color:#a0aec0; font-size:0.82rem; margin-bottom:20px;">Jump straight into common tasks</p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Clients" asp-action="Create"
                   style="background:linear-gradient(135deg,#1a3c5e,#2e86c1); color:white; border:none; padding:12px 20px; border-radius:10px; font-size:0.88rem; font-weight:600; text-decoration:none; display:flex; align-items:center; gap:8px; transition:all 0.2s;">
                    <i class="fas fa-user-plus"></i> Add Client
                </a>
                <a asp-controller="Contracts" asp-action="Create"
                   style="background:linear-gradient(135deg,#1e8449,#27ae60); color:white; border:none; padding:12px 20px; border-radius:10px; font-size:0.88rem; font-weight:600; text-decoration:none; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-file-circle-plus"></i> New Contract
                </a>
                <a asp-controller="ServiceRequests" asp-action="Create"
                   style="background:linear-gradient(135deg,#b7770d,#f39c12); color:white; border:none; padding:12px 20px; border-radius:10px; font-size:0.88rem; font-weight:600; text-decoration:none; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-clipboard-plus"></i> New Service Request
                </a>
                <a asp-controller="Contracts" asp-action="Index"
                   style="background:#f0f4f8; color:#1a3c5e; border:none; padding:12px 20px; border-radius:10px; font-size:0.88rem; font-weight:600; text-decoration:none; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-magnifying-glass"></i> Search Contracts
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div style="background:white; border-radius:14px; padding:24px; box-shadow:0 2px 12px rgba(0,0,0,0.06); height:100%;">
            <h5 style="color:#1a3c5e; font-weight:700; margin-bottom:6px;"><i class="fas fa-server me-2" style="color:#2e86c1;"></i>System Status</h5>
            <p style="color:#a0aec0; font-size:0.82rem; margin-bottom:20px;">All services operational</p>
            <div style="display:flex; flex-direction:column; gap:12px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-size:0.83rem; color:#4a5568;">API Service</span>
                    <span style="background:#eafaf1; color:#27ae60; font-size:0.72rem; font-weight:600; padding:4px 10px; border-radius:20px;"><i class="fas fa-circle me-1" style="font-size:0.5rem;"></i>Online</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-size:0.83rem; color:#4a5568;">Database</span>
                    <span style="background:#eafaf1; color:#27ae60; font-size:0.72rem; font-weight:600; padding:4px 10px; border-radius:20px;"><i class="fas fa-circle me-1" style="font-size:0.5rem;"></i>Online</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-size:0.83rem; color:#4a5568;">Currency Feed</span>
                    <span style="background:#eafaf1; color:#27ae60; font-size:0.72rem; font-weight:600; padding:4px 10px; border-radius:20px;"><i class="fas fa-circle me-1" style="font-size:0.5rem;"></i>Online</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-size:0.83rem; color:#4a5568;">Authentication</span>
                    <span style="background:#eafaf1; color:#27ae60; font-size:0.72rem; font-weight:600; padding:4px 10px; border-radius:20px;"><i class="fas fa-circle me-1" style="font-size:0.5rem;"></i>Secured</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Info Row -->
<div class="row g-3">
    <div class="col-md-6">
        <div style="background:white; border-radius:14px; padding:24px; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <h5 style="color:#1a3c5e; font-weight:700; margin-bottom:16px;"><i class="fas fa-circle-info me-2" style="color:#2e86c1;"></i>Contract Status Guide</h5>
            <div style="display:flex; flex-direction:column; gap:10px;">
                <div style="display:flex; align-items:center; gap:12px; padding:10px 14px; background:#f8fafc; border-radius:8px;">
                    <span style="background:#d5f5e3; color:#27ae60; font-size:0.72rem; font-weight:700; padding:4px 10px; border-radius:20px; min-width:70px; text-align:center;">Active</span>
                    <span style="font-size:0.83rem; color:#4a5568;">Contract is valid — service requests can be raised</span>
                </div>
                <div style="display:flex; align-items:center; gap:12px; padding:10px 14px; background:#f8fafc; border-radius:8px;">
                    <span style="background:#eaf2ff; color:#2e86c1; font-size:0.72rem; font-weight:700; padding:4px 10px; border-radius:20px; min-width:70px; text-align:center;">Draft</span>
                    <span style="font-size:0.83rem; color:#4a5568;">Contract pending approval — requests allowed</span>
                </div>
                <div style="display:flex; align-items:center; gap:12px; padding:10px 14px; background:#f8fafc; border-radius:8px;">
                    <span style="background:#fef9e7; color:#f39c12; font-size:0.72rem; font-weight:700; padding:4px 10px; border-radius:20px; min-width:70px; text-align:center;">On Hold</span>
                    <span style="font-size:0.83rem; color:#4a5568;">Contract paused — no new requests permitted</span>
                </div>
                <div style="display:flex; align-items:center; gap:12px; padding:10px 14px; background:#f8fafc; border-radius:8px;">
                    <span style="background:#fdf2f2; color:#e74c3c; font-size:0.72rem; font-weight:700; padding:4px 10px; border-radius:20px; min-width:70px; text-align:center;">Expired</span>
                    <span style="font-size:0.83rem; color:#4a5568;">Contract ended — no new requests permitted</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div style="background:white; border-radius:14px; padding:24px; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <h5 style="color:#1a3c5e; font-weight:700; margin-bottom:16px;"><i class="fas fa-globe me-2" style="color:#27ae60;"></i>Platform Features</h5>
            <div style="display:flex; flex-direction:column; gap:10px;">
                <div style="display:flex; align-items:center; gap:12px; padding:10px 14px; background:#f8fafc; border-radius:8px;">
                    <i class="fas fa-money-bill-transfer" style="color:#2e86c1; width:20px; text-align:center;"></i>
                    <span style="font-size:0.83rem; color:#4a5568;">Live USD to ZAR currency conversion on all invoices</span>
                </div>
                <div style="display:flex; align-items:center; gap:12px; padding:10px 14px; background:#f8fafc; border-radius:8px;">
                    <i class="fas fa-file-pdf" style="color:#e74c3c; width:20px; text-align:center;"></i>
                    <span style="font-size:0.83rem; color:#4a5568;">Secure PDF agreement upload and download</span>
                </div>
                <div style="display:flex; align-items:center; gap:12px; padding:10px 14px; background:#f8fafc; border-radius:8px;">
                    <i class="fas fa-filter" style="color:#27ae60; width:20px; text-align:center;"></i>
                    <span style="font-size:0.83rem; color:#4a5568;">Advanced contract filtering by date range and status</span>
                </div>
                <div style="display:flex; align-items:center; gap:12px; padding:10px 14px; background:#f8fafc; border-radius:8px;">
                    <i class="fas fa-shield-halved" style="color:#f39c12; width:20px; text-align:center;"></i>
                    <span style="font-size:0.83rem; color:#4a5568;">JWT-secured REST API with Swagger documentation</span>
                </div>
            </div>
        </div>
    </div>
</div>